# Cloudflare Workers static assets ignore list.
# Unlike Pages, Workers uploads everything in the assets directory by default —
# this keeps repo metadata and deploy config out of the deployed site.
.git
.gitignore
.pre-commit-config.yaml
wrangler.toml
.assetsignore
README.md
LICENSE.md
.idea
.vscode
.devcontainer
.claude
.wrangler
node_modules
**/.DS_Store
images/profile-variant.JPG
print
